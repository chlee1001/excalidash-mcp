# Inside the container, localhost is the container itself. Use
# host.docker.internal for an ExcaliDash on the same host, or an HTTPS URL.
EXCALIDASH_URL=http://host.docker.internal:6767
EXCALIDASH_API_KEY=replace-with-your-api-key

# Optional: drawing to select when a session starts.
# EXCALIDASH_DRAWING_ID=

# Optional: host port that Compose publishes on 127.0.0.1.
MCP_PORT=9003

# Optional: largest accepted HTTP request body in bytes (default 10 MiB).
# MCP_MAX_BODY_BYTES=10485760

# Optional: most concurrent MCP sessions (default 64).
# MCP_MAX_SESSIONS=64

# Optional: idle session timeout in milliseconds (default 30 minutes).
# MCP_SESSION_IDLE_MS=1800000
