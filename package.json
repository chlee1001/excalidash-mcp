{
  "name": "excalidash-mcp",
  "version": "0.4.0",
  "description": "MCP server for controlling self-hosted ExcaliDash drawings",
  "author": "Chaehyeon Lee",
  "license": "MIT",
  "keywords": [
    "mcp",
    "excalidash",
    "excalidraw"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "excalidash-mcp": "dist/index.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "!dist/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
